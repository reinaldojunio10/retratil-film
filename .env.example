# Conexão usada pelo app em tempo de execução (papel SEM privilégio de dono, sujeito ao RLS)
DATABASE_URL=postgres://retratil_app:SENHA@localhost:5432/retratil
# Conexão de administração, usada SOMENTE por migrations/scripts (nunca no app)
DATABASE_ADMIN_URL=postgres://retratil:SENHA@localhost:5432/retratil
# Banco exclusivo para testes de integração (será recriado pelos testes)
TEST_DATABASE_ADMIN_URL=postgres://retratil:SENHA@localhost:5432/retratil_test
TEST_DATABASE_URL=postgres://retratil_app:SENHA@localhost:5432/retratil_test
# Exige SSL no Postgres (ex.: Supabase). Valores: true | false
DATABASE_SSL=false

# URL pública do app (usada em links e no webhook)
APP_URL=http://localhost:3000
# Segredo para a rota de automações agendadas (/api/cron/automacoes) — string aleatória longa
CRON_SECRET=

# WhatsApp Business Platform (Cloud API oficial da Meta)
# Modo: disabled (padrão) | test (simula, nunca envia) | live (envio real; exige credenciais)
WHATSAPP_MODE=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
